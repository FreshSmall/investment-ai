{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "classification_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "sectors", "event_type", "importance", "reason"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
          "sectors": {
            "type": "array",
            "items": {"type": "string", "enum": ["__SECTORS__"]},
            "maxItems": 3
          },
          "event_type": {
            "type": "string",
            "enum": ["capacity_expansion", "policy", "earnings", "catalyst", "order_demand", "price", "supply", "risk", "funding", "other"]
          },
          "importance": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
          "reason": {"type": "string", "minLength": 2, "maxLength": 200}
        }
      }
    }
  }
}
