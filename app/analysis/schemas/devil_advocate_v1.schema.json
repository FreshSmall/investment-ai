{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "devil_advocate_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["thesis_id", "counter_points", "logic_gaps", "alternative_explanations", "overall_note"],
  "properties": {
    "thesis_id": {"type": "string", "enum": ["__THESES__"]},
    "counter_points": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_event_id"],
        "properties": {
          "text": {"type": "string", "minLength": 4, "maxLength": 400},
          "source_event_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
        }
      }
    },
    "logic_gaps": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 4, "maxLength": 300}},
    "alternative_explanations": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 4, "maxLength": 300}},
    "overall_note": {"type": "string", "minLength": 4, "maxLength": 500}
  }
}
