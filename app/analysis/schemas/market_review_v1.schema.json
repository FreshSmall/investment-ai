{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "market_review_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["market_summary", "sector_moves", "style_note", "risk_flags", "tomorrow_watch"],
  "properties": {
    "market_summary": {"type": "string", "minLength": 8, "maxLength": 400},
    "sector_moves": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sector", "direction", "note"],
        "properties": {
          "sector": {"type": "string", "minLength": 2, "maxLength": 32},
          "direction": {"type": "string", "enum": ["up", "down"]},
          "note": {"type": "string", "minLength": 2, "maxLength": 120}
        }
      }
    },
    "style_note": {"type": "string", "minLength": 4, "maxLength": 200},
    "risk_flags": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 2, "maxLength": 120}},
    "tomorrow_watch": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 2, "maxLength": 120}}
  }
}
