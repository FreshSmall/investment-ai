# Copy to `.env` and fill real values. NEVER commit the real `.env`.
# Connection spec is shared with stock-platform (same RDS instance, isolated database).

# MySQL (Aliyun RDS)
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=investment_ai

# Override for tests (integration/e2e): same instance, disposable database.
# TEST_DB_NAME=investment_ai_test

# LLM (OpenAI-compatible; GLM / DeepSeek / Qwen etc.)
LLM_API_KEY=your-llm-key
LLM_BASE_URL=https://api.deepseek.com/v1

# Optional: vault path override (defaults to ~/Investment-KB)
# IAI_VAULT_PATH=
