# Copy to `.env` and fill real values. NEVER commit the real `.env`.
# Connection spec is shared with stock-platform (same RDS instance, isolated database).

# MySQL (Aliyun RDS)
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=investment_ai

# Override for tests (integration/e2e): same instance, disposable database.
# TEST_DB_NAME=investment_ai_test

# LLM (GLM via BigModel OpenAI-compatible endpoint)
# API Key 在 https://bigmodel.cn 控制台生成后粘贴到 .env 的 LLM_API_KEY=
LLM_API_KEY=your-llm-key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional: vault path override (defaults to /Users/bjhl/GitRepository/Investment-KB)
# IAI_VAULT_PATH=
