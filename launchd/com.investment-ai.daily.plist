<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.investment-ai.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/bjhl/IdeaProjects/learn-project/investment-ai/.venv/bin/python</string>
        <string>/Users/bjhl/IdeaProjects/learn-project/investment-ai/main.py</string>
        <string>daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/bjhl/IdeaProjects/learn-project/investment-ai</string>

    <!-- 每天 20:00；Mac 睡眠错过时唤醒后补跑一次（daily 入口幂等防重复） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/bjhl/IdeaProjects/learn-project/investment-ai/logs/daily-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bjhl/IdeaProjects/learn-project/investment-ai/logs/daily-launchd.log</string>

    <!-- 上次异常退出后 60s 重启一次（watchdog 超时 os._exit(99) 场景） -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <true/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>60</integer>
</dict>
</plist>
