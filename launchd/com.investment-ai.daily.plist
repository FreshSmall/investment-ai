<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.investment-ai.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/bjhl/IdeaProjects/learn-project/investment-ai/.venv/bin/python</string>
        <string>/Users/bjhl/IdeaProjects/learn-project/investment-ai/main.py</string>
        <string>daily</string>
        <string>--force</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/bjhl/IdeaProjects/learn-project/investment-ai</string>

    <!-- 每天 09:00 与 22:00 各一次；--force 穿透当日 skip 门（靠 UNIQUE 缓存保证不重复分析，
         晚间运行将日报刷新为全天版）；Mac 睡眠错过时唤醒后补跑 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/bjhl/IdeaProjects/learn-project/investment-ai/logs/daily-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bjhl/IdeaProjects/learn-project/investment-ai/logs/daily-launchd.log</string>

    <!-- 仅异常退出时重启（watchdog 超时 os._exit(99) 场景）；SuccessfulExit=true 会导致
         每次正常跑完立即重拉、无限连环调用 LLM（2026-09-18 事故根因） -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>60</integer>
</dict>
</plist>
